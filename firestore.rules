rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SECURITY BOUNDARY
    // This repository is PUBLIC. These rules are the only thing standing
    // between an anonymous signup and every client's invoices, SOWs and
    // acceptance verdicts. Treat this file as production code.
    // Invariants: a principal never assigns their own role; a verdict is
    // written by an operator and is immutable; audit_logs are append-only;
    // admin resolves from a verified identity, never a bare email string.
    // Do not modify without running tests/firestore.rules.test.ts.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Bootstrap owner. Retained only until custom claims are provisioned.
    function isBootstrapOwner() {
      return isVerified() && request.auth.token.email == "Lang@theartificialbridge.com";
    }

    function isAdmin() {
      return isBootstrapOwner() || (
        isVerified() && (
          request.auth.token.admin == true ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        )
      );
    }

    function hasPermission(permission) {
      return isAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'client' &&
        exists(/databases/$(database)/documents/roles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)) &&
        get(/databases/$(database)/documents/roles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)).data.permissions[permission] == true
      );
    }

    function isOperator() {
      return isAdmin() || hasPermission('manageProjects');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role is string &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000000)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 60)) &&
             (!('company' in data) || (data.company is string && data.company.size() <= 120)) &&
             (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 120)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 300)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    function isValidRole(data) {
      return data.keys().hasAll(['name', 'permissions']) &&
             data.name is string &&
             data.permissions is map &&
             data.permissions.keys().hasAll(['manageSOWs', 'manageProposals', 'manageInvoices', 'manageProjects', 'manageRoles', 'viewAnalytics']);
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'clientUid', 'status']) &&
             data.title is string && data.title.size() < 200 &&
             data.clientUid is string &&
             (!('sowId' in data) || data.sowId is string) &&
             data.status in ['draft', 'active', 'completed'];
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['projectId', 'clientUid', 'amount', 'status', 'dueDate']) &&
             data.amount is number && data.amount > 0 &&
             data.status in ['unpaid', 'paid'] &&
             data.dueDate is string;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read']) &&
             data.userId is string &&
             data.title is string &&
             data.message is string &&
             data.type in ['reminder', 'update', 'alert'] &&
             data.read is bool;
    }

    function isValidSOW(data) {
      return data.keys().hasAll(['projectId', 'clientUid', 'content', 'status']) &&
             data.content is string && data.content.size() < 50000 &&
             data.status in ['draft', 'pending', 'signed'] &&
             (!('reviewFeedback' in data) || data.reviewFeedback is list);
    }

    function isValidSOWTemplate(data) {
      return data.keys().hasAll(['name', 'content']) &&
             data.name is string && data.name.size() < 100 &&
             data.content is string && data.content.size() < 50000;
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['clientUid', 'title', 'content', 'status']) &&
             data.clientUid is string &&
             data.title is string && data.title.size() < 200 &&
             data.content is string && data.content.size() < 50000 &&
             data.status in ['draft', 'sent', 'accepted', 'rejected'];
    }

    function isValidProposalTemplate(data) {
      return data.keys().hasAll(['name', 'content']) &&
             data.name is string && data.name.size() < 100 &&
             data.content is string && data.content.size() < 50000;
    }

    function isValidEngagement(data) {
      return data.keys().hasAll(['clientUid', 'status', 'createdAt']) &&
             data.clientUid is string &&
             data.status in ['interviewing', 'contracted', 'archived'] &&
             data.createdAt is string &&
             (!('acceptanceContract' in data) || (data.acceptanceContract is string && data.acceptanceContract.size() < 100000));
    }

    function isValidObjection(data) {
      return data.keys().hasAll(['objection', 'createdAt']) &&
             data.objection is string && data.objection.size() < 5000 &&
             data.createdAt is string &&
             (!('priceAtObjection' in data) || data.priceAtObjection is number);
    }

    function isValidBuildRun(data) {
      return data.keys().hasAll(['contractId', 'status', 'createdAt']) &&
             data.contractId is string &&
             data.status in ['staged', 'building', 'passed', 'blocked', 'handed_off'] &&
             data.createdAt is string;
    }

    function isValidCorpusAdapter(data) {
      return data.keys().hasAll(['name', 'reuseCount', 'isZeroCost']) &&
             data.name is string &&
             data.reuseCount is number &&
             data.isZeroCost is bool;
    }

    function isValidFixture(data) {
      return data.keys().hasAll(['name', 'vertical', 'inputData']) &&
             data.name is string &&
             data.vertical is string &&
             data.inputData is string;
    }

    function isValidVerification(data) {
      return data.keys().hasAll(['contractId', 'verdict', 'verdictTable', 'verifiedAt']) &&
             data.contractId is string &&
             data.verdict in ['PASS', 'FAIL', 'CONVERGED_WITH_RESIDUAL_RISKS', 'PLAN_DEFECT'] &&
             data.verdictTable is list &&
             data.verifiedAt is string;
    }

    function isValidErrorRemedy(data) {
      return data.keys().hasAll(['errorClass', 'failureMode', 'remedy']) &&
             data.errorClass is string &&
             data.failureMode is string &&
             data.remedy is string;
    }

    function isValidEstimate(data) {
      return data.keys().hasAll(['engagementId', 'vertical', 'quotedAmount', 'outcome', 'createdAt']) &&
             data.engagementId is string &&
             data.vertical is string &&
             data.quotedAmount is number && data.quotedAmount >= 0 &&
             data.outcome in ['quoted', 'won', 'lost', 'renegotiated', 'delivered_unbilled', 'delivered_discounted'] &&
             data.createdAt is string &&
             (!('floorAmount' in data) || data.floorAmount is number) &&
             (!('scopeUnits' in data) || data.scopeUnits is number) &&
             (!('actualHours' in data) || data.actualHours is number) &&
             (!('verificationId' in data) || data.verificationId is string);
    }

    function isValidMeeting(data) {
      return data.keys().hasAll(['title', 'meetingUri', 'meetingCode', 'status', 'createdAt', 'hostUid']) &&
             data.title is string && data.title.size() <= 200 &&
             data.meetingUri is string &&
             data.meetingCode is string &&
             data.hostUid is string &&
             data.status in ['scheduled', 'live', 'completed', 'cancelled'] &&
             data.createdAt is string;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'timestamp', 'actorUid']) &&
             data.action is string &&
             data.timestamp is string &&
             data.actorUid is string;
    }

    function isMeetingParticipant() {
      return isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        (('participantUids' in resource.data) && request.auth.uid in resource.data.participantUids)
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasPermission('manageRoles');
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (
                      hasPermission('manageRoles') ||
                      (isOwner(userId) && request.resource.data.role == 'client')
                    );
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (
                      hasPermission('manageRoles') ||
                      (isOwner(userId) && request.resource.data.role == resource.data.role)
                    );
      allow delete: if hasPermission('manageRoles');
    }

    match /roles/{roleId} {
      allow read: if hasPermission('manageRoles');
      allow create, update, delete: if hasPermission('manageRoles') && isValidRole(request.resource.data);
    }

    match /projects/{projectId} {
      allow read: if hasPermission('manageProjects') || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow create: if hasPermission('manageProjects') && isValidProject(request.resource.data);
      allow update: if hasPermission('manageProjects') && isValidProject(request.resource.data);
      allow delete: if hasPermission('manageProjects');
    }

    match /invoices/{invoiceId} {
      allow read: if hasPermission('manageInvoices') || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow create: if hasPermission('manageInvoices') && isValidInvoice(request.resource.data);
      allow update: if hasPermission('manageInvoices') && isValidInvoice(request.resource.data);
      allow delete: if hasPermission('manageInvoices');
    }

    match /sows/{sowId} {
      allow read: if hasPermission('manageSOWs') || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow create: if hasPermission('manageSOWs') && isValidSOW(request.resource.data);
      allow update: if (hasPermission('manageSOWs') && isValidSOW(request.resource.data)) ||
                     (isAuthenticated() && resource.data.clientUid == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signature', 'signedAt', 'status']) &&
                      request.resource.data.status == 'signed');
      allow delete: if hasPermission('manageSOWs');
    }

    match /sowTemplates/{templateId} {
      allow read: if hasPermission('manageSOWs');
      allow create, update, delete: if hasPermission('manageSOWs') && isValidSOWTemplate(request.resource.data);
    }

    match /proposals/{proposalId} {
      allow read: if hasPermission('manageProposals') || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow create: if hasPermission('manageProposals') && isValidProposal(request.resource.data);
      allow update: if hasPermission('manageProposals') && isValidProposal(request.resource.data);
      allow delete: if hasPermission('manageProposals');
    }

    match /proposalTemplates/{templateId} {
      allow read: if hasPermission('manageProposals');
      allow create, update, delete: if hasPermission('manageProposals') && isValidProposalTemplate(request.resource.data);
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidNotification(request.resource.data) && (
                      request.resource.data.userId == request.auth.uid || isAdmin()
                    );
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidNotification(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /engagements/{engagementId} {
      allow read: if isAuthenticated() && (resource.data.clientUid == request.auth.uid || isOperator() || hasPermission('manageProposals') || hasPermission('manageSOWs'));
      allow create: if isAuthenticated() && isValidEngagement(request.resource.data) && (
                      request.resource.data.clientUid == request.auth.uid || isOperator()
                    );
      allow update: if isAuthenticated() && isValidEngagement(request.resource.data) && (
                      resource.data.clientUid == request.auth.uid || isOperator() || hasPermission('manageProposals')
                    );
      allow delete: if isAdmin() || hasPermission('manageProposals');
    }

    match /objection_patterns/{objectionId} {
      allow read: if isOperator();
      allow create, update: if isOperator() && isValidObjection(request.resource.data);
      allow delete: if isAdmin();
    }

    match /build_runs/{buildRunId} {
      allow read: if isOperator();
      allow create, update: if isOperator() && isValidBuildRun(request.resource.data);
      allow delete: if isAdmin();
    }

    match /corpus_adapters/{adapterId} {
      allow read: if isOperator();
      allow create, update: if isOperator() && isValidCorpusAdapter(request.resource.data);
      allow delete: if isAdmin();
    }

    match /fixtures/{fixtureId} {
      allow read: if isOperator();
      allow create, update: if isOperator() && isValidFixture(request.resource.data);
      allow delete: if isAdmin();
    }

    match /verifications/{verificationId} {
      allow read: if isOperator() || (
                    isAuthenticated() &&
                    exists(/databases/$(database)/documents/engagements/$(resource.data.contractId)) &&
                    get(/databases/$(database)/documents/engagements/$(resource.data.contractId)).data.clientUid == request.auth.uid
                  );
      allow create: if isOperator() && isValidVerification(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /error_remedies/{remedyId} {
      allow read: if isOperator();
      allow create, update: if isOperator() && isValidErrorRemedy(request.resource.data);
      allow delete: if isAdmin();
    }

    match /estimates/{estimateId} {
      allow read: if isOperator();
      allow create, update: if isOperator() && isValidEstimate(request.resource.data);
      allow delete: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if isOperator() || isMeetingParticipant();
      allow create: if isAuthenticated() && isValidMeeting(request.resource.data) && (
                      request.resource.data.hostUid == request.auth.uid || isOperator()
                    );
      allow update: if isValidMeeting(request.resource.data) && (isOperator() || isMeetingParticipant());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.hostUid == request.auth.uid);
    }

    match /audit_logs/{auditId} {
      allow read: if isOperator();
      allow create: if isAuthenticated() && isValidAuditLog(request.resource.data) &&
                       request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}